NEXORA_APP_NAME=Nexora Backend
NEXORA_API_VERSION=0.2.0
NEXORA_ENV=development
NEXORA_DEBUG=true
NEXORA_DOWNLOAD_METADATA_DIAGNOSTICS=true
# Optional X/Twitter authenticated fallback. Provide a Netscape-format cookie
# file stored outside Git and treat it as a credential. Production deployments
# should provide this through a mounted runtime secret, never the image.
NEXORA_X_AUTH_COOKIE_FILE=
NEXORA_CORS_ORIGINS=http://localhost:3000,http://localhost:4200
DOWNLOAD_EXPIRATION_MINUTES=30
TEMP_FILE_RETENTION_MINUTES=15
FAILED_DOWNLOAD_RETENTION_MINUTES=0
CLEANUP_INTERVAL_MINUTES=5
